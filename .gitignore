node_modules/

# preview.py's render cache, including a throwaway Chrome profile.
# 3.1MB of it was committed once by a git add -A run whose cwd was this
# repo rather than wordcamp/website. Never track it.
tools/.preview-cache/

# Banner PNGs from design/tools/render.sh. Regenerate, don't commit.
design/exports/

# Campaign carousels live in the working copy only (wordcamp/design/carousels/).
# export-to-repo.sh never writes them here, and they must not arrive by hand:
# their assets are third-party sponsor logos and organizers' headshots, and
# their exports/ and thumbs/ are ~11MB of generated PNG.
design/carousels/
